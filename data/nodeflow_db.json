  "plugins": [
    {
      "id": "plugin-pii-masker",
      "name": "PII Sanitizer & Masker",
      "type": "piiMaskerPlugin",
      "description": "Zero-knowledge PII sanitizer that masks email addresses, credit cards, SSNs, and custom secrets locally.",
      "version": "1.0.0",
      "author": "SecOps Core",
      "icon": "ShieldCheck",
      "inputs": [
        {
          "id": "main",
          "label": "Data Input",
          "type": "main"
        }
      ],
      "outputs": [
        {
          "id": "main",
          "label": "Sanitized Output",
          "type": "main"
        }
      ],
      "parametersSchema": [
        {
          "name": "maskEmails",
          "label": "Mask Email Addresses",
          "type": "boolean",
          "default": true
        },
        {
          "name": "maskPhones",
          "label": "Mask Phone Numbers",
          "type": "boolean",
          "default": true
        },
        {
          "name": "redactKeys",
          "label": "Redact Object Keys (comma separated)",
          "type": "string",
          "default": "password, token, ssn, creditCard, secret"
        }
      ],
      "code": "const input = Array.isArray(inputs) ? inputs : [inputs];\nconst maskStr = (str) => {\n  if (typeof str !== 'string') return str;\n  let res = str;\n  if (params.maskEmails) {\n    res = res.replace(/([a-zA-Z0-9._-]+)@([a-zA-Z0-9._-]+\\.[a-zA-Z0-9._-]+)/gi, (m, u, d) => `${u.slice(0, 2)}***@${d}`);\n  }\n  if (params.maskPhones) {\n    res = res.replace(/\\b\\d{3}[-.]?\\d{3}[-.]?\\d{4}\\b/g, '***-***-****');\n  }\n  return res;\n};\n\nconst redactKeys = (params.redactKeys || '').split(',').map(s => s.trim().toLowerCase()).filter(Boolean);\n\nconst sanitizeObj = (val) => {\n  if (val === null || val === undefined) return val;\n  if (typeof val === 'string') return maskStr(val);\n  if (Array.isArray(val)) return val.map(sanitizeObj);\n  if (typeof val === 'object') {\n    const out = {};\n    for (const [k, v] of Object.entries(val)) {\n      if (redactKeys.includes(k.toLowerCase())) {\n        out[k] = '[REDACTED_PII]';\n      } else {\n        out[k] = sanitizeObj(v);\n      }\n    }\n    return out;\n  }\n  return val;\n};\n\nhelpers.log('Sanitizing data with zero-knowledge PII plugin');\nreturn sanitizeObj(input);\n",
      "createdAt": "2026-09-11T00:00:00.000Z",
      "updatedAt": "2026-09-11T12:03:31.428Z"
    },
    {
      "id": "plugin-csv-parser",
      "name": "CSV to JSON Transformer",
      "type": "csvParserPlugin",
      "description": "Transforms raw CSV text or file streams into structured JSON array records with automatic type casting.",
      "version": "1.0.0",
      "author": "Data Integration",
      "icon": "FileSpreadsheet",
      "inputs": [
        {
          "id": "main",
          "label": "Raw CSV Data",
          "type": "main"
        }
      ],
      "outputs": [
        {
          "id": "main",
          "label": "Parsed Records",
          "type": "main"
        }
      ],
      "parametersSchema": [
        {
          "name": "delimiter",
          "label": "CSV Delimiter",
          "type": "select",
          "options": [
            {
              "label": "Comma (,)",
              "value": ","
            },
            {
              "label": "Semicolon (;)",
              "value": ";"
            },
            {
              "label": "Tab (\\t)",
              "value": "\t"
            }
          ],
          "default": ","
        },
        {
          "name": "trimWhitespace",
          "label": "Trim Header & Cell Whitespace",
          "type": "boolean",
          "default": true
        }
      ],
      "code": "// CSV to JSON Transformer\nconst firstItem = Array.isArray(inputs) ? inputs[0] : inputs;\nconst rawCsv = firstItem?.csv || firstItem?.rawContent || (typeof firstItem === 'string' ? firstItem : 'id,name,role,active\\n1,Alice,Engineer,true\\n2,Bob,Architect,true');\n\nconst lines = rawCsv.split(/\\r?\\n/).filter(line => line.trim().length > 0);\nif (lines.length === 0) return [];\n\nconst delimiter = params.delimiter || ',';\nconst headers = lines[0].split(delimiter).map(h => params.trimWhitespace ? h.trim() : h);\n\nconst records = lines.slice(1).map((line, idx) => {\n  const cells = line.split(delimiter).map(c => params.trimWhitespace ? c.trim() : c);\n  const row = { _rowNumber: idx + 1 };\n  headers.forEach((h, i) => {\n    let val = cells[i] || '';\n    if (/^\\d+$/.test(val)) val = parseInt(val, 10);\n    else if (/^\\d+\\.\\d+$/.test(val)) val = parseFloat(val);\n    else if (val.toLowerCase() === 'true') val = true;\n    else if (val.toLowerCase() === 'false') val = false;\n    row[h] = val;\n  });\n  return row;\n});\n\nhelpers.log(`Parsed ${records.length} records from CSV content`);\nreturn records;\n",
      "createdAt": "2026-09-11T00:00:00.000Z",
      "updatedAt": "2026-09-11T12:03:31.436Z"
    }
  ],
